{
  "name": "drivego",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "playwright test",
    "test:db": "node --test tests/db/*.test.mjs",
    "test:unit": "node --test server/lib/*.test.ts",
    "dev": "DEV=1 node tools/serve-new.mjs",
    "build": "npm run build -w server",
    "typecheck": "npm run typecheck -w server",
    "test:record": "TARGET=legacy playwright test --update-snapshots=all",
    "fixture": "node tools/make-fixture.mjs",
    "fonts": "node tools/vendor-fonts.mjs",
    "inventory": "node tools/inventory.mjs",
    "coverage": "rm -rf coverage/raw && COVERAGE=1 playwright test; node tools/inventory.mjs",
    "selfcheck": "node tools/selfcheck.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "acorn": "^8.15.0",
    "acorn-walk": "^8.3.4",
    "esbuild": "0.28.2",
    "playwright-core": "1.56.1"
  },
  "workspaces": [
    "server"
  ]
}
