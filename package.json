{
  "name": "drivego",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "playwright test",
    "test:record": "TARGET=legacy playwright test --update-snapshots=all",
    "fixture": "node tools/make-fixture.mjs",
    "fonts": "node tools/vendor-fonts.mjs",
    "inventory": "node tools/inventory.mjs",
    "coverage": "rm -rf coverage/raw && COVERAGE=1 playwright test && node tools/coverage-report.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1"
  }
}
